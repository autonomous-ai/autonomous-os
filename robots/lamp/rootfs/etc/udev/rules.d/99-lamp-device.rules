# Lamp udev roles. Tracked source: robots/lamp/rootfs/etc/udev/rules.d/, installed
# onto / at image build and on every device-profile OTA — edit HERE, not on the
# device, or the next OTA overwrites the hand edit.
#
# Every rule maps a vid:pid to a ROLE name (device-camera, device_micro1, ...)
# that /etc/asound.conf and /opt/hal/.env refer to, so a hardware swap is one
# line here and nothing else. Several vid:pid may fill the same role; only the
# one actually plugged in wins.
#
# Final hardware fit, recorded from lamp-4ace on 2026-09-18: ZVCAI camera,
# C-Media audio adapter (sensing mic and speaker on one card), Jieli voice mic,
# CH340 servo. Earlier fits (SunplusIT camera, TTGK USB speaker) are dropped;
# see git history if one has to come back.

# Camera role -> /dev/device-camera (HAL_CAMERA_NAME). index==0 picks the capture
# node, not the UVC metadata sibling. The ZVCAI exposes a USB audio interface
# too, but no mic is wired to it — it gets no role.
# ZVCAI USB_Camera
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="01da", ATTRS{idProduct}=="5875", ATTR{index}=="0", SYMLINK+="device-camera"

# Servo driver: QinHeng CH340 -> /dev/device-servo
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", SYMLINK+="device-servo"

# Voice mic: Jieli Technology -> ALSA card device_micro2
SUBSYSTEM=="sound", ACTION=="change", ATTRS{idVendor}=="4c4a", ATTRS{idProduct}=="4155", ATTR{id}="device_micro2"

# Sensing mic + speaker: C-Media Audio Adapter (Unitek Y-247A) -> ALSA card
# device_micro1. Its playback side is the speaker: /etc/asound.conf aliases
# device_speaker onto this card. A card gets exactly one udev id, so the second
# role is an ALSA alias, not a second rule here.
SUBSYSTEM=="sound", ACTION=="change", ATTRS{idVendor}=="0d8c", ATTRS{idProduct}=="0014", ATTR{id}="device_micro1"
