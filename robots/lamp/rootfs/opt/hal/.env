HAL_MODE=production
HAL_LOG_LEVEL=INFO
HAL_AUDIO_INPUT_ALSA=plug:device_micro2
HAL_AUDIO_SENSING_DEVICE=plug:device_micro1
HAL_AUDIO_OUTPUT_ALSA=plug:device_speaker
HAL_PRE_ROLL_FRAMES=12
HAL_VAD_THRESHOLD=500
HAL_STT_KEEPALIVE=false
HAL_SPEECH_HOLDOFF=0.05
# Loud-noise ("startle") threshold for the sensing mic (ES8389 onboard).
# Measured on-device 2026-07-03: quiet room ~10 RMS, close thunder peaks ~755.
HAL_SOUND_RMS_THRESHOLD=755
HAL_TTS_SPEED=1.1
HAL_SILERO_ENABLED=true
HAL_SILERO_THRESHOLD=0.15
HAL_SILERO_CHUNK_SIZE=512
HAL_WEBRTCVAD_ENABLED=true
# Entry gate for opening a capture session. 0 (the loosest of 0-3) let room noise
# open sessions, which STT then turned into invented filler words — reaching the
# realtime model as turns of pure noise. Back to the code default of 2. The filter
# passes a window when ANY 30ms frame in it is speech, so this stays permissive
# for real far-field speech. Lower again if quiet utterances stop opening a session.
HAL_WEBRTCVAD_AGGRESSIVENESS=2
HAL_WEBRTCVAD_FRAME_MS=30
HAL_MOTION_ENABLED=true
HAL_EMOTION_ENABLED=true
HAL_POSE_MOTION_ENABLED=false
HAL_MOTION_CONFIDENCE_THRESHOLD=0.4
HAL_EMOTION_CONFIDENCE_THRESHOLD=0.5
HAL_EMOTION_DEDUP_WINDOW_S=600
HAL_BACKCHANNEL_INTERVAL_S=5
HAL_CAMERA_WIDTH=1280
HAL_CAMERA_HEIGHT=720
HAL_CAMERA_STREAM_WIDTH=960
HAL_CAMERA_STREAM_HEIGHT=540
HAL_CAMERA_INDEX=0
HAL_CAMERA_NAME=OPENAICAM
HAL_TRACKING_MAX_DURATION_S=10
SPEAKER_MATCH_COS=0.5
HAL_DL_ENCRYPTION=true
HAL_DL_ENCRYPTION_REQUIRED=false
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
DEVICE_TYPE=lamp
DEVICES_DIR=/opt/devices
HAL_SILENCE_TIMEOUT=1.2
# Hard ceiling on one capture. Only reached when the silence clock never
# expires, i.e. a room loud enough that every frame reads as speech — a real
# speaker always pauses longer than SILENCE_TIMEOUT within 20s. Code default
# is 30s; 20 caps the wasted wait and the STT bill on that failure mode.
HAL_MAX_SESSION_DURATION_S=20
HAL_REALTIME_NATIVE_AUDIO=false
HAL_REALTIME_REQUIRE_TRANSCRIPT=true
HAL_REALTIME_REQUIRE_SPEECH_ON_EMPTY_STT=true
HAL_REALTIME_NOISE_SPEECH_RATIO=0.55
HAL_REALTIME_TURN_DETECTION=off
HAL_REALTIME_FILLER_DELAY_S=0.5
HAL_WARM_MIC=true
HAL_WARM_MIC_ECHO_SKIP_MAX_S=0.1
HAL_ECHO_RMS_FLOOR=300

# --- Acoustic echo cancellation (WebRTC AEC3) + barge-in ---
# Needs the `aec-audio-processing` binding. Without it every AEC entry point is
# a no-op and barge-in can never fire, since it gates on the canceller running.
# DELAY_MS is the one value that MUST be measured per device: on lamp-ee17 the
# real speaker->mic lag was 205ms, not the 150 first assumed, and it drifts
# ~667ppm because mic and speaker are separate USB devices with free-running
# clocks. Re-measure with HAL_AEC_DUMP_DIR after any audio hardware change.
HAL_AEC_ENABLED=true
HAL_AEC_DELAY_MS=205
HAL_AEC_TAIL_S=2.0
HAL_AEC_NS=true
HAL_AEC_REF_MS=500
# Barge-in rides on the canceller. Neither LEVEL nor the speech gate can reject
# the lamp's own voice: echo IS speech, and the echo ceiling sits ABOVE real
# interruptions at every speaker volume — measured 27/08/2026 in a silent room,
# echo vs person: 25% 9804/8027, 40% 9969/6956-8027, 65% 13560/6956. Turning the
# speaker down does not help (24dB of mixer moved the echo under 3dB), so do not
# re-tune RMS_THRESHOLD; 5000 stays low on purpose to catch a normal voice.
# What actually separates them is HAL_BARGE_IN_ECHO_MATCH — see hal/.env.example.
# That one is NOT set here on purpose: it is a normalised, unitless measure, so
# it carries across bodies and lives at the code default (0.65). The two below
# it do belong here, because both compensate for how late THIS hardware detects
# an interruption, and that depends on the echo it has to out-shout.
#
# WARM_FRAMES=1, not the code default 2: with 2 the level gate needed two
# consecutive 64ms frames over threshold and real interruptions never gathered
# them — measured 27/08/2026, replies logged `drain peak RMS=8047, longest run
# 1 frames`, so nothing ever reached the echo test. Every barge-in measurement
# in the code comments was taken at 1. The echo test is what keeps this safe
# now; the level gate no longer has to be the defence on its own.
#
# HAL_BARGE_IN_PRE_ROLL_FRAMES is deliberately NOT set here. Its code default
# (12) already equals this body's HAL_PRE_ROLL_FRAMES at the top of this file,
# so setting it would be a no-op — it only buys anything on a body that leaves
# the general pre-roll at 8. A barge-in turn on the lamp therefore gets the same
# 768ms as an ordinary one, and that still clips roughly 0.7s off a fast opening
# clause ("If you can, just go ahead and eat it." reached STT as 'just go ahead
# and eat it.'). Raising it is not the fix — at 24 the buffer reached back past
# the interruption into the reply's own echo and STT transcribed the LAMP.
# Filtering the pre-roll against the reply's transcript is; not done yet.
#
# HAL_BARGE_IN_TRIGGER_FRAMES and _BLOCK_MS are legacy-monitor knobs,
# unreachable while HAL_WARM_MIC is true.
# OFF, and this is a measured verdict rather than caution. 27/08/2026, 20
# replies into a silent room: the lamp cut ITSELF off 4 times. Then 79 labelled
# candidate windows (69 echo from an empty room, 10 confirmed interruptions)
# were scored against every feature available — envelope correlation, residual
# skew, coupling offset, APM suppression, and magnitude-squared coherence, the
# textbook double-talk statistic. Best AUC was 0.72, and every threshold giving
# 0% self-interruption cost 90-100% missed interruptions:
#   coherence  echo 0.03..0.60   person 0.04..0.57
#   corr       echo 0.25..0.99   person 0.41..0.95
#   skew       echo -6.5..67.1   person -1.0..119.7
# The classes overlap almost completely, so no classifier on this signal will
# do better. The cause is upstream: AEC3 reaches only ~6dB ERLE here because
# the speaker and mic are separate USB devices with free-running clocks, and
# during double talk the APM does not attenuate the near-end talker but removes
# them (measured: a frame reading 7426 on the raw mic left the APM at 5).
# Re-enable only after the echo path itself improves — a neural canceller
# (DTLN-aec runs real-time on a Pi 3 B+) or one sound card for both directions.
# The detector, its measurements and the rejected approaches are kept in
# drivers/voice/aec.py so none of it is retried from scratch.
# Tap-to-interrupt (GPIO button, TTP223 touchpad) does not depend on any of
# this and stays available.
HAL_BARGE_IN_ENABLED=false
HAL_BARGE_IN_RMS_THRESHOLD=5000
HAL_BARGE_IN_WARM_FRAMES=1
HAL_BARGE_IN_REQUIRE_SPEECH=true
HAL_BARGE_IN_SPEECH_RATIO=0.35
HAL_BARGE_IN_SPEECH_FRAMES=6

HAL_TTS_ELEVENLABS_WS=false
HAL_REALTIME_ZOMBIE_RECONNECT_AFTER=3
# Camera exposure: auto — manual + high gain (192/255) drives the ISP into a
# sticky color-corruption state (green/magenta posterized frames). If a stable
# frame rate matters more than adaptive brightness, switch to manual but keep
# gain <= ~144 (e.g. HAL_CAMERA_EXPOSURE=330, HAL_CAMERA_GAIN=96).
HAL_CAMERA_AUTO_EXPOSURE=auto
HAL_BT_PREFER_HFP=1
HAL_WAKEWORD_FOLLOWUP_TIMEOUT_S=60
# Keep nearby stranger conversations out of the voice gate. Set true only for
# a guest-first deployment where a stranger entering view may start talking.
HAL_PRESENCE_WAKE_STRANGERS=false

# Turning toward the lamp and speaking opens the wake gate, alongside the wake
# phrase and the click. Shadow off means it actually opens the gate rather than
# only logging what it would have done. Both were set by hand on lamp-0c89 long
# before they were written down here; the file is the record now.
HAL_GAZE_WAKE=true
HAL_GAZE_SHADOW=false

# YuNet's eye/nose landmarks on lamp-0c89 read a user looking straight into the
# camera as 55.7-59.1 deg with glasses. The code default remains 25 deg; this
# measured device tuning accepts that front-facing posture. The 60% multi-sample
# vote remains unchanged, so a lone frame cannot open the gate.
HAL_GAZE_MAX_YAW_DEG=60

# Read by os-server, which loads this file too (see cmd/os-server/main.go), not
# by HAL. When the realtime agent answers a NEW utterance out loud, the
# main-agent turn still working on the previous question loses the speaker and
# its pending fillers, instead of answering a moment later in a different
# voice. Speech only — that turn's servo/LED markers still run, unlike the
# physical click.
#
# Opt-in: the code default is OFF, so this line matches the default and exists
# to be flipped. Set to 1 (os-server restart required) to try the behaviour on
# this body.
OS_REALTIME_AUTO_MUTE=0
