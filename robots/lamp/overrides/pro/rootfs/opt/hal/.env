# Applied when /etc/autonomous/hardware-profile contains pro.
# Standard microphones: Jieli USB for voice/STT, C-Media for sensing.
# The speaker remains on ReSpeaker Lite with the existing softvol/volume policy.
# Use software AEC because capture no longer uses the Lite processed mic.
HAL_AUDIO_INPUT_ALSA=plug:device_micro2
HAL_AUDIO_SENSING_DEVICE=plug:device_micro1
HAL_AUDIO_OUTPUT_ALSA=plug:device_speaker
HAL_AEC_ENABLED=true
HAL_SILERO_THRESHOLD=0.15
HAL_LIVE_MODE=false
HAL_LIVE_UPLINK_DURING_PLAYBACK=cancelled
