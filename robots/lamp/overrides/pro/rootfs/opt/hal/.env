# Applied when /etc/autonomous/hardware-profile contains pro.
# Lamp Pro audio (Seeed ReSpeaker Lite build, 2026-09-18, lamp-0c4e):
#   device_micro2  = voice/STT mic -> ReSpeaker Lite USB (ALSA card "Lite"), on-chip
#                    AEC/NS/AGC, fixed 16 kHz; both USB channels carry the same processed signal
#   device_micro1  = sensing mic   -> onboard ES8389 (card sndi2s4), loud-noise/startle only
#   device_speaker = speaker       -> ReSpeaker Lite amp output; volume = ALSA softvol "Speaker"
#                    (the Lite has no hardware mixer), created at boot by respeaker-lite-softvol.service
# The Lite cancels its own playback in hardware, so HAL_AEC_ENABLED stays false.
HAL_AUDIO_INPUT_ALSA=plug:device_micro2
HAL_AUDIO_SENSING_DEVICE=plug:device_micro1
HAL_AUDIO_OUTPUT_ALSA=plug:device_speaker
HAL_AEC_ENABLED=false
HAL_LIVE_MODE=true
HAL_LIVE_UPLINK_DURING_PLAYBACK=always
