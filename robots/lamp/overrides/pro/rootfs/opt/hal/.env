# Applied when /etc/autonomous/hardware-profile contains pro.
# Lamp Pro audio (Seeed ReSpeaker Lite build, 2026-09-18, lamp-0c4e):
#   device_micro2  = voice/STT mic -> ReSpeaker Lite USB (ALSA card "Lite"), on-chip
#                    AEC/NS/AGC, fixed 16 kHz; both USB channels carry the same processed signal
#   device_micro1  = sensing mic   -> onboard ES8389 (card sndi2s4), loud-noise/startle only
#   device_speaker = speaker       -> ReSpeaker Lite amp output; volume = ALSA softvol "Speaker"
#                    (the Lite has no hardware mixer), created at boot by respeaker-lite-softvol.service
# The Lite cancels its own playback in hardware, so HAL_AEC_ENABLED stays false.
HAL_AUDIO_INPUT_ALSA=plug:device_micro2
HAL_AUDIO_SENSING_DEVICE=plug:device_micro1
HAL_AUDIO_OUTPUT_ALSA=plug:device_speaker
# Software canceller on top of the Lite's on-chip AEC. Only ~6 dB on this card
# (see above) but it is the last linear stage available; harmless when the chip
# has already cancelled. The XVF3800 build ran with it off.
HAL_AEC_ENABLED=true
# Silero on the Lite's processed (NS-heavy) capture scores quiet sentence
# starts 0.10-0.15 (13 rejections in that band clustered right after the user
# spoke, lamp-0c4e 2026-09-21); 0.15 dropped them, 0.10 keeps them.
HAL_SILERO_THRESHOLD=0.10
# Live mode OFF on the ReSpeaker Lite build (2026-09-21): its on-chip AEC leaves
# 600-2200 RMS of the lamp's own voice on the mic (see below), so a live session
# hears the reply as the user. The turn path drains the mic while TTS plays and
# never has that problem. Barge-in is lost either way; the XVF3800 build kept
# live on because its canceller was good enough for "always".
HAL_LIVE_MODE=false
# ReSpeaker Lite AEC, measured on lamp-0c4e 2026-09-21 (arecord the Lite's
# capture while TTS played through it): residual after the on-chip canceller
# 600-2200 RMS, peaks 4.5k-25k against a 266-770 floor; the chip's AGC lifts
# the residual and the USB firmware exposes no AEC/AGC tuning. The XVF3800 this
# replaced cancelled well enough for "always" on its own; the Lite does not.
# HAL's canceller on top adds only ~6 dB (HAL_AEC_DUMP_DIR cross-correlation:
# delay 180-208 ms = the 205 default, mic/reference correlation 0.04 because
# the chip's residual is non-linear). Kept "always" for barge-in parity with
# the old array at the user's call; expect occasional self-hearing at the
# start of a reply. "mute" was verified to stop it (130/130 frames
# substituted, no echoed transcript) at the cost of barge-in.
HAL_LIVE_UPLINK_DURING_PLAYBACK=always
