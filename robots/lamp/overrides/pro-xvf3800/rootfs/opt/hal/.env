# Applied when /etc/autonomous/hardware-profile contains pro-xvf3800.
# Lamp Pro with the reSpeaker XVF3800 4-mic array (ALSA card "Array"): the
# tested assembly before the ReSpeaker Lite (2026-09-21). Kept as a selectable
# profile so a return to the array is one line in hardware-profile, not a
# reconstruction from git history. Its on-chip canceller was good enough to
# run live mode without software AEC. Hardware-AEC live handling is shared
# with other profiles that explicitly disable the software canceller.
HAL_AUDIO_INPUT_ALSA=plug:device_micro2
HAL_AUDIO_SENSING_DEVICE=plug:device_micro1
HAL_AUDIO_OUTPUT_ALSA=plug:device_speaker
HAL_AEC_ENABLED=false
HAL_LIVE_MODE=true
# Demo default: linear PCM duck gain, not system volume; tune per device.
HAL_LIVE_DUCK_GAIN=0.12
HAL_LIVE_UPLINK_DURING_PLAYBACK=always
