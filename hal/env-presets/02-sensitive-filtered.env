# Voice VAD preset 02: more sensitive, still filtered.
# Use when preset 01 still needs a strong first syllable.

HAL_VAD_THRESHOLD=500
HAL_SPEECH_HOLDOFF=0.05
HAL_PRE_ROLL_FRAMES=12
HAL_SILENCE_TIMEOUT=3.0

# Keep filters on, tuned for sensitivity. Sensitivity comes from the RMS/Silero
# thresholds, not from dropping the WebRTC gate to 0 — that let room noise open
# capture sessions, which STT then turned into invented filler words.
HAL_WEBRTCVAD_ENABLED=true
HAL_WEBRTCVAD_AGGRESSIVENESS=2
HAL_WEBRTCVAD_FRAME_MS=30

HAL_SILERO_ENABLED=true
HAL_SILERO_THRESHOLD=0.15
HAL_SILERO_CHUNK_SIZE=512

# Cost guard: leave keepalive off unless first-word clipping is still bad.
HAL_STT_KEEPALIVE=false

HAL_WARM_MIC=true
HAL_WARM_MIC_ECHO_SKIP_MAX_S=0.1
HAL_ECHO_RMS_FLOOR=300

HAL_REALTIME_REQUIRE_TRANSCRIPT=true
HAL_REALTIME_REQUIRE_SPEECH_ON_EMPTY_STT=true
HAL_REALTIME_NOISE_SPEECH_RATIO=0.55
HAL_REALTIME_TURN_DETECTION=off
