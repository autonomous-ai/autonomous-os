# Voice VAD preset 01: balanced sensitivity, cost-safe.
# Try this first on a real device.

HAL_VAD_THRESHOLD=650
HAL_SPEECH_HOLDOFF=0.10
HAL_PRE_ROLL_FRAMES=12
HAL_SILENCE_TIMEOUT=2.5

# Keep noise filters enabled, but lenient. Aggressiveness stays at the code
# default of 2: at 0 room noise opened capture sessions, and STT turned those into
# invented filler words that reached the realtime model as turns of pure noise.
HAL_WEBRTCVAD_ENABLED=true
HAL_WEBRTCVAD_AGGRESSIVENESS=2
HAL_WEBRTCVAD_FRAME_MS=30

HAL_SILERO_ENABLED=true
HAL_SILERO_THRESHOLD=0.18
HAL_SILERO_CHUNK_SIZE=512

# Cost guard: do not keep STT connected while idle.
HAL_STT_KEEPALIVE=false

# Reduce clipped first words after TTS/music.
HAL_WARM_MIC=true
HAL_WARM_MIC_ECHO_SKIP_MAX_S=0.1
HAL_ECHO_RMS_FLOOR=300

# Cost guard: Gemini replies only when STT produced text.
HAL_REALTIME_REQUIRE_TRANSCRIPT=true
HAL_REALTIME_REQUIRE_SPEECH_ON_EMPTY_STT=true
HAL_REALTIME_NOISE_SPEECH_RATIO=0.55
HAL_REALTIME_TURN_DETECTION=off
