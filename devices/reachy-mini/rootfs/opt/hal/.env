HAL_MODE=production
HAL_LOG_LEVEL=INFO
DEVICE_TYPE=reachy-mini
DEVICES_DIR=/opt/devices

# --- Pollen daemon (motion driver connects here) ---
#REACHY_DAEMON_HOST=localhost
#REACHY_DAEMON_PORT=8000
# The same daemon also owns the camera and both ALSA PCMs until asked to hand
# them over. That is NOT configured here — it is declared in DEVICE.md as
# `owner: pollen_daemon` on the audio and vision capabilities, and the handover
# reuses the host/port above. See hal/drivers/media_owner/.

# --- Audio (mic array + 5W speaker) ---
# Recon 2026-07-29: ONE USB card carries both capture and playback —
#   card 0: Audio [Reachy Mini Audio], device 0  (Pollen Robotics USB Audio)
# Aliases are defined in devices/reachy-mini/rootfs/etc/asound.conf and address
# the card by NAME, so HDMI cards (1, 2) cannot shift the index out from under us.
# NOTE: the Pollen daemon holds these PCMs while media is acquired; HAL must call
# POST /api/media/release on the daemon before opening them (see runtime.md).
HAL_AUDIO_INPUT_ALSA=plug:device_mic
HAL_AUDIO_OUTPUT_ALSA=plug:device_speaker
# Sound sensing records its own 0.5s RMS samples through sounddevice. Lamp points
# this at a second physical mic; Reachy has only the one card, so it must be the
# SAME shared PCM the voice pipeline uses. Left unset it falls back to the raw
# PortAudio index for hw:0,0 — an exclusive open at 44100 Hz against a card
# already held by the 16 kHz capture, which fails several times a minute and
# fills the journal with pa_linux_alsa "AlsaOpen failed" while sensing silently
# reports nothing. Going through plug:device_mic shares via dsnoop and resamples.
HAL_AUDIO_SENSING_DEVICE=plug:device_mic
HAL_VAD_THRESHOLD=500
HAL_SPEECH_HOLDOFF=0.05
HAL_SILENCE_TIMEOUT=3.0
HAL_STT_KEEPALIVE=false
HAL_SILERO_ENABLED=true
HAL_SILERO_THRESHOLD=0.15
HAL_SILERO_CHUNK_SIZE=512
HAL_WEBRTCVAD_ENABLED=true
HAL_WEBRTCVAD_AGGRESSIVENESS=0
HAL_WEBRTCVAD_FRAME_MS=30
HAL_TTS_SPEED=1.1

# --- Camera (wide-angle HD in head) ---
# The head camera is a CSI imx708_wide behind unicam/libcamera, NOT a UVC device,
# so DEVICE.md selects `driver: rpicam` — HAL reads MJPEG from an rpicam-vid
# child process instead of cv2.VideoCapture. HAL_CAMERA_INDEX is unused by that
# backend (libcamera picks the sensor by pipeline); width/height below are passed
# to rpicam-vid. See runtime.md "Camera Stack".
HAL_CAMERA_INDEX=0
HAL_CAMERA_WIDTH=1280
HAL_CAMERA_HEIGHT=720
HAL_CAMERA_STREAM_WIDTH=960
HAL_CAMERA_STREAM_HEIGHT=540
HAL_CAMERA_AUTO_EXPOSURE=auto

# --- Sensing ---
HAL_MOTION_ENABLED=true
HAL_EMOTION_ENABLED=true
HAL_POSE_MOTION_ENABLED=false
HAL_MOTION_CONFIDENCE_THRESHOLD=0.4
HAL_EMOTION_CONFIDENCE_THRESHOLD=0.5
HAL_DL_ENCRYPTION=true
HAL_DL_ENCRYPTION_REQUIRED=false
SPEAKER_MATCH_THRESHOLD=0.7
SPEAKER_ENROLL_CONSISTENCY_THRESHOLD=0.7

# --- Realtime voice ---
HAL_REALTIME_TURN_DETECTION=off
HAL_WARM_MIC=true
HAL_WARM_MIC_ECHO_SKIP_MAX_S=0.1
HAL_ECHO_RMS_FLOOR=300

# --- CPU tuning (RPi CM4 4 GB, shared with the Pollen daemon) ---
# Recon 2026-07-29: idle load average was ~2.1-2.5 on 4 cores with only the
# daemon running (control loop measured at ~49 Hz, not the 100 Hz quoted by
# Pollen docs). Budget accordingly before enabling extra sensing.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
